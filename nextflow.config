manifest {
    name            = 'snRNA-sequencing'
    description     = 'snRNA-seq pipeline: sex differences in early-life stress induced chronic low back pain (rat dorsal horn spinal cord)'
    author          = 'Deepika Singhal'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0'
}

params {
    // Input
    samplesheet      = null

    // Seurat integration
    min_features     = 500
    nfeatures        = 2000

    // DESeq2
    group_var        = 'group'
    sample_var       = 'orig.ident'

    // Annotation
    species_dataset  = 'rnorvegicus_gene_ensembl'

    // Output
    outdir           = 'results'

    // Container
    container_r      = 'ghcr.io/deepikasinghal14/snrna-seq-r:0.1.0'

    // Resource caps (see check_max() below). Profiles like `test` override
    // these; they must stay ABOVE the `profiles` block so the override wins
    // (Nextflow config is applied in file order).
    max_cpus     = 8
    max_memory   = 32.GB
    max_time     = 8.h
}

profiles {
    standard {
        process.executor = 'local'
        docker.enabled    = true
    }

    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    slurm {
        process.executor = 'slurm'
        docker.enabled    = false
        singularity.enabled = true
    }

    test {
        includeConfig 'conf/test.config'
    }
}

// Default (full-scale) resource requests. The `test` profile overrides
// these to fit CI / laptop-scale runs -- see conf/test.config.
process {
    withLabel: process_low {
        cpus   = { check_max( 2, 'cpus' ) }
        memory = { check_max( 4.GB, 'memory' ) }
        time   = { check_max( 1.h, 'time' ) }
    }
    withLabel: process_medium {
        cpus   = { check_max( 4, 'cpus' ) }
        memory = { check_max( 16.GB, 'memory' ) }
        time   = { check_max( 4.h, 'time' ) }
    }
    withLabel: process_high {
        cpus   = { check_max( 8, 'cpus' ) }
        memory = { check_max( 32.GB, 'memory' ) }
        time   = { check_max( 8.h, 'time' ) }
    }
}

// Caps requested resources at the configured max, following the nf-core
// convention. This is what lets `-profile test` shrink resource requests
// with a single set of params instead of duplicating withLabel blocks.
def check_max(obj, type) {
    if (type == 'cpus') {
        try {
            return Math.min(obj as int, params.max_cpus as int)
        } catch (all) { return obj }
    } else if (type == 'memory') {
        try {
            return obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1 ? params.max_memory as nextflow.util.MemoryUnit : obj
        } catch (all) { return obj }
    } else if (type == 'time') {
        try {
            return obj.compareTo(params.max_time as nextflow.util.Duration) == 1 ? params.max_time as nextflow.util.Duration : obj
        } catch (all) { return obj }
    }
    return obj
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}

dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}
