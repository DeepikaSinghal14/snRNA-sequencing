/*
 * Test profile - runs the pipeline structure end-to-end on tiny stub inputs.
 * Use with -stub-run to validate the DAG without requiring real R packages
 * or real CellRanger/CellBender output:
 *
 *   nextflow run main.nf -profile test -stub-run
 *
 * To test with the real R containers on a small real dataset, drop actual
 * (subsampled) CellRanger/CellBender output into data/test/ following the
 * same structure and run without -stub-run.
 */

params {
    samplesheet  = "${projectDir}/data/test/samplesheet.csv"
    outdir       = 'results/test'
    min_features = 10
    nfeatures    = 50

    // Cap all process_low/medium/high resource requests (see check_max()
    // in nextflow.config) so the pipeline runs on a laptop or CI runner.
    max_cpus     = 2
    max_memory   = 4.GB
    max_time     = 30.m
}
